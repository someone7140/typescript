{
  "name": "politics-post-api",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "node --inspect-brk=9229 ./node_modules/.bin/vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "migrate": "npx dotenv -e .dev.vars -- tsx --tsconfig tsconfig.migrate.json ./src/db/migration/allMigration.ts",
    "postinstall": "patch-package && npm run cf-typegen"
  },
  "dependencies": {
    "@hono/graphql-server": "^0.7.1",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-scope-auth": "^4.2.2",
    "@std/uuid": "npm:@jsr/std__uuid@^1.1.2",
    "camelcase-keys": "^10.0.3",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "hono": "^4.13.4",
    "mongodb": "^7.7.0",
    "openid-client": "^6.8.8",
    "patch-package": "^8.0.1",
    "snakecase-keys": "^9.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-ssr-components": "^0.9.0",
    "wrangler": "^4.156.0"
  }
}
