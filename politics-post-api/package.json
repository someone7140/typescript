{
  "name": "politics-post-api",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "node --inspect-brk=9229 ./node_modules/.bin/vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "migrate": "npx dotenv -e .dev.vars -- tsx --tsconfig tsconfig.migrate.json ./src/db/migration/allMigration.ts",
    "postinstall": "patch-package && npm run cf-typegen"
  },
  "dependencies": {
    "@hono/graphql-server": "^0.7.0",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-scope-auth": "^4.1.7",
    "@std/uuid": "npm:@jsr/std__uuid@^1.1.1",
    "camelcase-keys": "^10.0.2",
    "graphql": "^17.0.2",
    "graphql-scalars": "^1.25.0",
    "hono": "^4.12.29",
    "mongodb": "^7.5.0",
    "openid-client": "^6.8.4",
    "patch-package": "^8.0.1",
    "snakecase-keys": "^9.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.6.1",
    "wrangler": "^4.110.0"
  }
}
